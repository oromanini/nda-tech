# Banco de dados
DB_ROOT_PASSWORD=rootpassword
DB_HOST=db
DB_PORT=3306
DB_USER=nda_user
DB_PASSWORD=nda_pass
DB_NAME=nda_form

# E-mail (SMTP Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_CC=nda@alluz.tech
EMAIL_FROM=Alluz Tech <nda@alluz.tech>

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# Admin
# Gere o hash com: docker run --rm node:20-slim node -e "require('bcrypt').hash('suasenha',10).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# DocuSeal
DOCUSEAL_API_KEY=
# Segredo que o webhook do DocuSeal envia no header X-Docuseal-Secret (openssl rand -hex 32)
DOCUSEAL_WEBHOOK_SECRET=

# DRI v2 — integração com o Deal (contracts/README §4). Gere cada valor com: openssl rand -hex 32
NDA_PUBLIC_URL=https://nda.alluz.tech
# Formulário sem convite (/) só enquanto true. Desligar depois que o Deal estiver emitindo todos os convites.
LEGACY_NDA_FORM_ENABLED=true
# Deal → nda-form (comando nda.convite.criar): o Deal assina com este par
INTEGRACAO_DEAL_TOKEN=
INTEGRACAO_DEAL_HMAC=
INTEGRACAO_DEAL_HMAC_ANTERIOR=
# nda-form → Deal (eventos nda.*): o nda-form assina com este par
DEAL_URL=https://deal.alluz.tech
INTEGRACAO_NDA_FORM_TOKEN=
INTEGRACAO_NDA_FORM_HMAC=
# Cloud Scheduler → /api/jobs/outbox e /api/jobs/lembretes
JOBS_TOKEN=

# App
PORT=3000
NODE_ENV=production
