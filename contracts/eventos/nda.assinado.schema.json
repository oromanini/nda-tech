    },
    "vigente_ate": {
      "type": "string",
      "format": "date"
    },
    "documento_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "dados_juridicos": {
      "$ref": "https://contracts.alluz.tech/v1/comum.schema.json#/$defs/dados_juridicos"
