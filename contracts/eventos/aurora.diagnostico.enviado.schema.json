{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.alluz.tech/v1/eventos/aurora.diagnostico.enviado.schema.json",
  "title": "dados de aurora.diagnostico.enviado",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_ref": {
      "type": "string",
      "pattern": "^aurora:meeting:\\d+$"
    },
    "cliente": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "empresa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "responsavel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "email": {
          "$ref": "https://contracts.alluz.tech/v1/comum.schema.json#/$defs/email"
        }
      },
      "required": [
        "empresa",
        "responsavel",
        "email"
      ]
    },
    "tipo_sugerido": {
      "$ref": "https://contracts.alluz.tech/v1/comum.schema.json#/$defs/tipo_projeto"
    },
    "tipo_justificativa": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "tipo_confianca": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reuniao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "realizada_em": {
          "type": "string",
          "format": "date-time"
        },
        "duracao_segundos": {
          "type": "integer",
          "minimum": 0
        },
        "participantes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "required": [
        "id",
        "realizada_em"
      ]
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resumo_executivo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "secoes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "titulo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "itens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "titulo",
              "itens"
            ]
          }
        },
        "transcricao": {
          "type": "string"
        },
        "observacoes": {
          "type": "string"
        }
      },
      "required": [
        "resumo_executivo",
        "secoes"
      ]
    }
  },
  "required": [
    "source_ref",
    "cliente",
    "tipo_sugerido",
    "tipo_justificativa",
    "reuniao",
    "briefing"
  ]
}